APP_NAME="MenuTag Generator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Every user-visible text is Italian (product requirement).
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB via Sail (docker-compose service "mariadb"). Placeholder
# credentials only — never commit real secrets.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=menutag_generator
DB_USERNAME=sail
DB_PASSWORD=password

# Async generation and DB-backed sessions are product requirements: the
# worker container runs queue:work on this same connection.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must stay ABOVE the job timeout (product.engine.job_timeout_s = 120 s),
# or the database queue re-delivers a job still legitimately running. The
# Sail worker sets it too (docker-compose.yml).
DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

# Python interpreter of the geometry engine virtualenv. Leave it COMMENTED:
# outside Docker the config default (engine/.venv/bin/python3 relative to the
# project root) applies; inside the Sail containers docker-compose.yml already
# sets it to the image venv (/opt/menutag-engine/venv/bin/python3, created by
# the Dockerfile outside the bind mount).
# MENUTAG_ENGINE_PYTHON=/opt/menutag-engine/venv/bin/python3

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sail (optional overrides)
# APP_PORT=80
# VITE_PORT=5173
# FORWARD_DB_PORT=3306
# WWWUSER=1000
# WWWGROUP=1000
